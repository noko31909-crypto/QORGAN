# Скопируйте в .env и подставьте значения. Не коммитьте .env.

# --- Профиль учебного центра (включает детекцию по умолчанию, без демо-сида) ---
QORGAN_PROFILE=centers

# --- Обязательно в production / Docker ---
APP_ENV=production
SECRET_KEY=replace_with_random_string_at_least_32_chars
CORS_ALLOWED_ORIGINS=https://your-web-app.example.com
WS_API_KEY=replace_with_random_shared_secret

# Демо-данные (для центров оставьте 0)
DEMO_SEED=0

# Детекция (при QORGAN_PROFILE=centers по умолчанию уже включена; явно 0 чтобы выключить)
ENABLE_DETECTION=1

# Модель (по умолчанию /app/models/best.onnx в Docker = корень репозитория)
# MODEL_PATH=

# Код организации по умолчанию для bootstrap-камеры и демо (если включите DEMO_SEED=1)
DEFAULT_SCHOOL_CODE=SCH-TRAINING-01

# Первая камера при пустой БД: индекс USB-камеры или RTSP URL (рекомендуется для центров)
BOOTSTRAP_CAMERA_STREAM=0
BOOTSTRAP_CAMERA_NAME=Main camera
BOOTSTRAP_CAMERA_LOCATION=Training hall

# Пороги детекции (опционально)
# CONFIDENCE_THRESHOLD=0.35
# ALERT_COOLDOWN_SECONDS=10
# PERSISTENCE_FRAMES=2

# Только для отладки: подмена камеры демо-роликом при ошибке открытия (в центрах по умолчанию выкл.)
ALLOW_DEMO_VIDEO_FALLBACK=0

# В production симуляция алерта выключена; для учений включите явно:
# ALLOW_SIMULATE_WEAPON_ALERT=1
