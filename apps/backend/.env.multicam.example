# ============================================================
# Qorgan — Конфигурация для 20-30 камер (multi-camera)
# Скопируйте в .env и подставьте значения.
# ============================================================

# --- Профиль ---
QORGAN_PROFILE=centers

# --- Обязательно ---
APP_ENV=production
SECRET_KEY=replace_with_random_string_at_least_32_chars
CORS_ALLOWED_ORIGINS=https://your-web-app.example.com
WS_API_KEY=replace_with_random_shared_secret

# --- Демо ---
DEMO_SEED=0

# --- Детекция ---
ENABLE_DETECTION=1

# --- Оптимизация для многокамерного режима ---

# Максимальное кол-во камер одновременно (по умолчанию 30)
DETECTION_MAX_CAMERAS=30

# Максимальное кол-во потоков детекции (по умолчанию 8)
# Рекомендация: 2-4 на каждый CPU core
DETECTION_MAX_WORKERS=8

# Пропуск кадров для снижения нагрузки
# 1 = каждый кадр, 2 = каждый второй, 3 = каждый третий (рекомендуется)
DETECTION_FRAME_SKIP=2

# Лимит памяти процесса в MB (по умолчанию 3000MB = 3GB)
DETECTION_MEMORY_LIMIT_MB=3000

# Разрешение фрейма для детекции (по умолчанию 640x480)
# Ниже разрешение = быстрее инференс, но хуже детекция мелких объектов
DETECTION_FRAME_WIDTH=640
DETECTION_FRAME_HEIGHT=480

# Максимальное кол-во зрителей одного видео-потока
MAX_VIDEO_FEED_VIEWERS=5

# Пропуск кадров в видео-потоке (рекомендуется 3-5)
VIDEO_FEED_SKIP=3

# --- Модель ---
MODEL_PATH=

# --- Камеры ---
BOOTSTRAP_CAMERA_STREAM=
BOOTSTRAP_CAMERA_NAME=Main camera
BOOTSTRAP_CAMERA_LOCATION=Training hall
DEFAULT_SCHOOL_CODE=SCH-TRAINING-01

# --- Пороги ---
CONFIDENCE_THRESHOLD=0.30
ALERT_COOLDOWN_SECONDS=10
PERSISTENCE_FRAMES=3
MIN_BBOX_AREA_RATIO=0.001
MAX_BBOX_AREA_RATIO=0.95

# --- Только отладка ---
ALLOW_DEMO_VIDEO_FALLBACK=0
ALLOW_SIMULATE_WEAPON_ALERT=1
